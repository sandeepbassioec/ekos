# ESIP AI Proxy configuration — copy to `.env` and fill in.
# NEVER commit the real .env (see .gitignore).

# Server
PORT=8787
# Comma-separated list of allowed browser origins (the Vite dev server by default)
ALLOWED_ORIGIN=http://localhost:5173

# AWS Bedrock (Knowledge Hub analysis, search, summaries)
# Use a freshly ROTATED Bedrock API key — the old one was committed to source and must be revoked.
BEDROCK_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6

# Groq (BRD import + estimation WBS generation)
# Use a freshly ROTATED Groq key — the old one was committed to source and must be revoked.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
