generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  oktaId       String?  @unique
  fullName     String?
  role         String   // admin, manager, architect, developer, viewer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProjects       Project[]              @relation("ProjectCreator")
  createdTeams          Team[]                 @relation("TeamCreator")
  teamMemberships       TeamMember[]
  wbsTasks              WbsTask[]              @relation("TaskCreator")
  updatedWbsTasks       WbsTask[]              @relation("TaskUpdater")
  projectCollaborations ProjectCollaborator[]
  architectureArtifacts ArchitectureArtifact[]
  invitationsSent       Invitation[]           @relation("InvitationSender")
  auditLogs             AuditLog[]
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  creator     User         @relation("TeamCreator", fields: [createdBy], references: [id])
  members     TeamMember[]
  projects    Project[]
  invitations Invitation[]
}

model TeamMember {
  teamId   String
  userId   String
  role     String   // manager, member
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Project {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  status              String   @default("draft") // draft, in_review, approved, archived
  estimationTechnique String?
  createdBy           String
  teamId              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creator               User                      @relation("ProjectCreator", fields: [createdBy], references: [id])
  team                  Team?                     @relation(fields: [teamId], references: [id])
  wbsTasks              WbsTask[]
  collaborators         ProjectCollaborator[]
  architectureArtifacts ArchitectureArtifact[]
  invitations           Invitation[]
  pis                   PI[]
  sprints               Sprint[]
  requirements          Requirement[]
}

model WbsTask {
  id                       String   @id @default(uuid())
  projectId                String
  parentId                 String?
  name                     String
  description              String?
  complexity               String? // simple, medium, complex
  estimatedHours           Float?
  developerEstimatedHours  Float?
  actualHours              Float?
  status                   String   @default("pending") // pending, approved, rejected
  developerNotes           String?
  managerNotes             String?
  createdBy                String
  updatedBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    WbsTask?  @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  WbsTask[] @relation("WbsHierarchy")
  creator   User      @relation("TaskCreator", fields: [createdBy], references: [id])
  updater   User?     @relation("TaskUpdater", fields: [updatedBy], references: [id])
}

model ProjectCollaborator {
  projectId  String
  userId     String
  permission String   // view, edit, approve
  expiresAt  DateTime?
  grantedBy  String
  grantedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ArchitectureArtifact {
  id        String   @id @default(uuid())
  projectId String
  type      String   // hld, lld, infrastructure, security
  content   String   // JSON stored as string
  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])
}

model Invitation {
  id         String    @id @default(uuid())
  email      String
  teamId     String?
  projectId  String?
  role       String?
  permission String?
  token      String    @unique
  expiresAt  DateTime
  createdBy  String
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User     @relation("InvitationSender", fields: [createdBy], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    String   // JSON stored as string
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PI {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  startDate   String?
  endDate     String?
  status      String   @default("planned") // planned, active, completed
  objectives  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprints      Sprint[]
  requirements Requirement[]

  @@index([projectId])
}

model Sprint {
  id        String   @id @default(uuid())
  projectId String
  piId      String?
  name      String
  startDate String?
  endDate   String?
  status    String   @default("planned") // planned, active, completed
  goals     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pi           PI?           @relation(fields: [piId], references: [id], onDelete: SetNull)
  requirements Requirement[]

  @@index([projectId])
  @@index([piId])
}

model Requirement {
  id          String   @id @default(uuid())
  projectId   String
  piId        String?
  sprintId    String?
  title       String
  description String?
  category    String // functional, non-functional, security, integration, data, etc.
  priority    String   @default("medium") // low, medium, high, critical
  status      String   @default("draft") // draft, defined, approved, in_progress, completed
  tags        String? // JSON array stored as string
  metadata    String? // JSON stored as string (for category-specific fields)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pi      PI?     @relation(fields: [piId], references: [id], onDelete: SetNull)
  sprint  Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([piId])
  @@index([sprintId])
  @@index([category])
  @@index([status])
}